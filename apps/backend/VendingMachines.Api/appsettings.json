{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "RefreshReuseGraceSeconds": 10,
    "RefreshCookieSameSite": "Strict"
  },
  "AccountEmail": {
    "Enabled": false,
    "Port": 587,
    "TimeoutSeconds": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.vendmachine.com.br",
      "https://icolangelo.github.io"
    ]
  },
  "WebSockets": {
    "AllowedOrigins": []
  },
  "Telemetry": {
    "RequireDeviceCredentials": false,
    "HandshakeTimeoutSeconds": 10,
    "HeartbeatIntervalSeconds": 30,
    "OfflineAfterSeconds": 90,
    "SelectionTimeoutSeconds": 120,
    "PaymentTimeoutSeconds": 300,
    "DeliveryTimeoutSeconds": 60,
    "ClosureTimeoutSeconds": 30,
    "AckTimeoutSeconds": 5,
    "AckRetries": 3,
    "MaxMessageBytes": 65536
  },
  "MdbStatus": {
    "PollIntervalSeconds": 30,
    "StaleAfterSeconds": 90,
    "ResponseTimeoutSeconds": 5,
    "AutoOpenCooldownSeconds": 30,
    "PollJitterSeconds": 5,
    "BatchSize": 25,
    "EnforceOnManualStart": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_NEON_HOST;Database=neondb;Username=YOUR_USERNAME;Password=YOUR_PASSWORD;SSL Mode=Require;"
  },
  "MercadoPago": {
    "ClientId": "7902965695113613",
    "WebhookUrl": "https://api.vendmachine.com.br/webhooks/mercadopago"
  }
}
