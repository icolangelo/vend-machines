# Configure como variáveis/segredos do runtime. Não copie valores para o repositório.
# Para Staging, use os valores próprios descritos em backend-staging-environment.example.
# Não reutilize client ID, webhook, banco, chaves ou origens de Production.
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
Jwt__Key=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
Encryption__Key=REPLACE_WITH_CURRENT_LEGACY_AES_SECRET
Encryption__LegacyKey=REPLACE_WITH_CURRENT_LEGACY_AES_SECRET
Encryption__WriteLegacyFormat=true
Encryption__RequireLegacyData=true
MercadoPago__ClientId=REPLACE_WITH_PRODUCTION_APPLICATION_CLIENT_ID
MercadoPago__WebhookUrl=https://REPLACE_WITH_PRODUCTION_API_HOST/webhooks/mercadopago
MercadoPago__ClientSecret=REPLACE_WITH_ROTATED_MERCADO_PAGO_CLIENT_SECRET
MercadoPago__WebhookSecret=REPLACE_WITH_ROTATED_MERCADO_PAGO_WEBHOOK_SECRET
ConnectionStrings__DefaultConnection=Host=REPLACE_WITH_POSTGRESQL_HOST;Database=REPLACE_WITH_DATABASE;Username=REPLACE_WITH_USERNAME;Password=REPLACE_WITH_PASSWORD;SSL Mode=Require
Cors__AllowedOrigins__0=https://REPLACE_WITH_PRODUCTION_FRONTEND_HOST
WebSockets__AllowedOrigins__0=https://REPLACE_WITH_PRODUCTION_FRONTEND_HOST
Telemetry__MaxPendingInboundMessages=5000
Payments__MaxOutstandingWebhookMessages=5000
Telemetry__ApplicationStoppingDrainTimeoutSeconds=40
# Para coexistência side-by-side, configure a origem privada da API anterior enquanto
# ela mantiver sockets MDB legados. Sem valor, readiness bloqueia conexões legadas online.
Telemetry__LegacyApiBaseUrl=
# Mantém compatibilidade com máquinas legadas sem credencial individual.
# Só mude para true após provisionar todas as máquinas suportadas e homologar firmware MDB.
Telemetry__RequireDeviceCredentials=false
AccountEmail__Enabled=true
AccountEmail__PublicBaseUrl=https://REPLACE_WITH_PRODUCTION_FRONTEND_HOST
AccountEmail__Host=REPLACE_WITH_APPROVED_SMTP_HOST
AccountEmail__Port=587
AccountEmail__Username=REPLACE_WITH_SMTP_USERNAME
AccountEmail__Password=REPLACE_WITH_SMTP_PASSWORD
AccountEmail__FromAddress=REPLACE_WITH_VERIFIED_SENDER_ADDRESS
AccountEmail__FromName=Vend Machines
AccountEmail__TimeoutSeconds=15
ForwardedHeaders__Enabled=false
# O rate limit usa o IP remoto. Atrás de proxy, com este valor false, todos os clientes
# podem compartilhar o limite da conexão do proxy (12 req/min na política auth).
# Ative somente depois de confirmar os IPs vistos pela API como origem das conexões do proxy.
# Exemplo: ForwardedHeaders__KnownProxies__0=10.0.0.10
# Para mais de um proxy, configure índices adicionais e ajuste ForwardLimit ao número de saltos confiáveis.
ForwardedHeaders__ForwardLimit=1
